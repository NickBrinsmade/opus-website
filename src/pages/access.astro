---
import Base from '../layouts/Base.astro';
import AccessForm from '../components/AccessForm.astro';
import Phone from '../components/Phone.astro';
import { STATS, TESTFLIGHT_URL } from '../lib/site';
---
<Base title="Get the Opus beta" description="Opus is in testing on iPhone and Android. Join on iPhone through TestFlight today, or leave your email for an Android invite.">
  <section class="access-page ground">
    <div class="wrap grid">
      <div>
        <p class="eyebrow">Early access</p>
        <h1 class="display">Try the Opus beta.</h1>
        <p class="lede">On iPhone you can join right now through TestFlight. On Android, leave your email and we’ll send you an invite. We’re letting Android testers in every week.</p>
        <AccessForm placement="access-page" tone="dark" />
        <ol class="what">
          <li><strong>iPhone:</strong> install Apple’s free TestFlight app, then <a href={TESTFLIGHT_URL} target="_blank" rel="noopener">open our TestFlight link</a> on your phone. Opus installs like any other app.</li>
          <li><strong>Android:</strong> you’ll get a Google Play testing link. Opt in with the Google account you use on your phone, then install Opus from the Play Store.</li>
          <li><strong>In return:</strong> use it at a museum or two, and tell us what broke. That’s it.</li>
        </ol>
      </div>
      <div class="phones" aria-hidden="true">
        <Phone screen="home" alt="" width={240} eager class="a1" />
        <Phone screen="profile" alt="" width={240} eager class="a2" />
      </div>
    </div>
  </section>
  <section class="measure facts">
    <p>Opus already knows {STATS.works}+ works by {STATS.artists}+ artists across {STATS.museums}+ museums and collections, and about {STATS.recognizable} of them can be recognized from a photo.</p>
  </section>
</Base>
<style>
  .access-page { padding: 72px 0 80px; overflow: hidden; }
  .grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; }
  .eyebrow { color: #d9b56a; }
  h1 { font-size: clamp(38px, 5.4vw, 60px); margin: 12px 0 16px; color: #fff; }
  .lede { color: #ead9c7; font-size: 19px; margin: 0 0 28px; max-width: 32em; }
  .what { margin: 36px 0 0; padding-left: 20px; color: #e3d3c2; display: grid; gap: 12px; max-width: 36em; }
  .what strong { color: #fff; }
  .what a { color: #f1d38c; }
  .phones { position: relative; height: 540px; }
  :global(.a1) { position: absolute; left: 0; top: 30px; transform: rotate(-6deg); }
  :global(.a2) { position: absolute; right: 0; top: 0; transform: rotate(5deg); }
  .facts { padding-top: 48px; text-align: center; color: var(--ink-2); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } .phones { display: none; } }
</style>
