---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import InlineCta from '../../components/InlineCta.astro';
import EndCta from '../../components/EndCta.astro';
import StickyCta from '../../components/StickyCta.astro';
import GuideCard from '../../components/GuideCard.astro';
import Phone from '../../components/Phone.astro';
import { allGuides, readingMinutes, fmtDate, isDraft, type Guide } from '../../lib/guides';
import { CATEGORIES, url } from '../../lib/site';

export async function getStaticPaths() {
  const guides = await allGuides();
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide, guides } }));
}

interface Props { guide: Guide; guides: Guide[] }
const { guide, guides } = Astro.props;
const d = guide.data;
const { Content, headings } = await render(guide);
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingMinutes(guide.body);
const pageUrl = new URL(url(`/guides/${guide.id}/`), Astro.site).href;

// Related: hand-picked first, then same category, then newest.
const others = guides.filter((g) => g.id !== guide.id);
const picked = d.related.map((s) => others.find((g) => g.id === s)).filter(Boolean) as Guide[];
const rest = others.filter((g) => !picked.includes(g)).sort((a, b) => Number(b.data.category === d.category) - Number(a.data.category === d.category));
const related = [...picked, ...rest].slice(0, 3);

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.published.toISOString(),
    dateModified: (d.updated ?? d.published).toISOString(),
    author: { '@type': 'Person', name: d.author },
    publisher: { '@type': 'Organization', name: 'Opus', logo: { '@type': 'ImageObject', url: new URL(url('/img/icon-512.png'), Astro.site).href } },
    mainEntityOfPage: pageUrl,
    ...(d.hero ? { image: new URL(url(d.hero.src), Astro.site).href } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(url('/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL(url('/guides/'), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
];
if (d.faq.length) jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---
<Base title={d.title} description={d.description} type="article" image={d.hero?.src} jsonLd={jsonLd} noindex={isDraft(guide)}>
  {isDraft(guide) && <div class="draft-bar">Draft: only visible in local preview. Approve by moving it into src/content/guides.</div>}
  <article class="guide">
    <header class="g-head measure">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={url('/')}>Home</a><span>/</span><a href={url('/guides/')}>Guides</a><span>/</span><a href={url(`/guides/#${d.category}`)}>{CATEGORIES[d.category]}</a>
      </nav>
      <h1 class="display">{d.title}</h1>
      <p class="dek">{d.dek}</p>
      <p class="byline">
        By {d.author} · {d.updated ? <>Updated <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time></> : <time datetime={d.published.toISOString()}>{fmtDate(d.published)}</time>} · {minutes} min read
      </p>
    </header>

    {d.hero && (
      <figure class="hero wrap">
        <img src={url(d.hero.src)} alt={d.hero.alt} width="1600" height="900" fetchpriority="high" />
        <figcaption>{d.hero.credit}</figcaption>
      </figure>
    )}

    <div class="layout wrap">
      <aside class="toc" aria-label="On this page">
        {toc.length > 2 && (
          <nav>
            <p class="eyebrow">On this page</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
      </aside>
      <div class="prose" data-article-body>
        <Content components={{ InlineCta, Phone }} />

        {d.faq.length > 0 && (
          <section class="g-faq">
            <h2 id="faq">Frequently asked questions</h2>
            {d.faq.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
          </section>
        )}

        <EndCta />
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="wrap more" aria-labelledby="more-title">
      <h2 id="more-title" class="display">Keep reading</h2>
      <div class="cards">{related.map((g) => <GuideCard guide={g} />)}</div>
    </section>
  )}
  <StickyCta slug={guide.id} />
</Base>

<style>
  .draft-bar { background: var(--dab-orange); color: #2a1300; text-align: center; font: 600 14px/1.3 var(--sans); padding: 10px 16px; }
  .g-head { padding-top: 56px; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--ink-3); margin-bottom: 22px; }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  h1 { font-size: clamp(36px, 5.4vw, 56px); margin: 0 0 16px; }
  .dek { font: 400 21px/1.45 var(--serif); color: var(--ink-2); margin: 0 0 18px; }
  .byline { font-size: 14px; color: var(--ink-3); margin: 0; }
  .hero { margin: 36px auto 0; }
  .hero img { width: 100%; border-radius: 18px; aspect-ratio: 16 / 9; object-fit: cover; }
  .hero figcaption { font-size: 13px; color: var(--ink-3); margin-top: 8px; }

  .layout { display: grid; grid-template-columns: 220px minmax(0, var(--measure)) 1fr; gap: 48px; margin-top: 44px; }
  .toc nav { position: sticky; top: 96px; }
  .toc ol { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 10px; counter-reset: t; }
  .toc a { color: var(--ink-2); text-decoration: none; font-size: 14px; line-height: 1.35; display: block; }
  .toc a:hover { color: var(--ink); }

  .prose { font: 400 19px/1.7 var(--serif); }
  .prose :global(h2) { font: 500 32px/1.15 var(--display); margin: 56px 0 14px; scroll-margin-top: 90px; }
  .prose :global(h3) { font: 650 20px/1.3 var(--sans); margin: 34px 0 8px; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 20px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(li::marker) { color: var(--oxblood); }
  .prose :global(strong) { font-weight: 650; }
  .prose :global(blockquote) { margin: 28px 0; padding: 4px 0 4px 22px; border-left: 3px solid var(--gilt); font-style: italic; color: var(--ink-2); }
  .prose :global(figure) { margin: 32px 0; }
  .prose :global(figure img) { border-radius: 12px; }
  .prose :global(figcaption) { font: 400 14px/1.45 var(--sans); color: var(--ink-3); margin-top: 8px; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font: 400 15px/1.45 var(--sans); margin: 24px 0 28px; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .prose :global(th) { font-weight: 650; background: var(--paper-2); }
  .prose :global(.answer) { background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius); padding: 20px 24px; margin: 0 0 28px; font-size: 18px; }
  .prose :global(.answer > :last-child) { margin-bottom: 0; }
  .prose :global(.answer .eyebrow) { color: var(--oxblood); margin: 0 0 8px; display: block; }
  @media (prefers-color-scheme: dark) { .prose :global(.answer .eyebrow) { color: var(--gilt); } }
  .prose :global(.not-prose) { font-family: var(--sans); }
  .g-faq :global(h3) { margin-top: 24px; }

  .more { padding-top: 80px; }
  .more h2 { font-size: 34px; margin: 0 0 22px; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

  @media (max-width: 1100px) { .layout { grid-template-columns: minmax(0, var(--measure)); justify-content: center; } .toc { display: none; } }
  @media (max-width: 900px) { .cards { grid-template-columns: 1fr; } .prose { font-size: 18px; } }
</style>
