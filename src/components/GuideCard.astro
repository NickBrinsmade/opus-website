---
import { url, CATEGORIES } from '../lib/site';
import { readingMinutes, isDraft, type Guide } from '../lib/guides';
interface Props { guide: Guide }
const { guide } = Astro.props;
const d = guide.data;
---
<a class="card" href={url(`/guides/${guide.id}/`)}>
  {d.hero && <img src={url(d.hero.src)} alt="" loading="lazy" width="640" height="400" />}
  <div class="body">
    <p class="eyebrow">{CATEGORIES[d.category]} · {readingMinutes(guide.body)} min{isDraft(guide) && ' · DRAFT'}</p>
    <h3>{d.title}</h3>
    <p>{d.dek}</p>
  </div>
</a>
<style>
  .card { display: flex; flex-direction: column; text-decoration: none; color: inherit; background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .card:hover { transform: translateY(-2px); box-shadow: 0 18px 36px -24px rgba(58, 18, 25, 0.45); }
  img { aspect-ratio: 16 / 10; object-fit: cover; width: 100%; }
  .body { padding: 18px 20px 22px; }
  .eyebrow { margin: 0 0 8px; }
  h3 { font: 500 23px/1.2 var(--display); margin: 0 0 8px; }
  p:last-child { margin: 0; color: var(--ink-2); font-size: 15px; }
</style>
