---
import { url } from '../lib/site';
interface Props { screen: string; alt: string; width?: number; eager?: boolean; class?: string }
const { screen, alt, width = 280, eager = false, class: cls } = Astro.props;
---
<figure class:list={['phone', cls]} style={`--w:${width}px`}>
  <img src={url(`/img/screens/${screen}.webp`)} width="786" height="1707" alt={alt}
       loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
</figure>
<style>
  .phone {
    margin: 0; width: var(--w); max-width: 100%;
    padding: 9px; border-radius: calc(var(--w) * 0.16);
    background: linear-gradient(145deg, #3b3533, #121010);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset, 0 40px 80px -30px rgba(30, 6, 10, 0.65), 0 18px 30px -18px rgba(0, 0, 0, 0.5);
  }
  .phone img { width: 100%; border-radius: calc(var(--w) * 0.13); background: #111; }
</style>
