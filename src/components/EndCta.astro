---
import AccessForm from './AccessForm.astro';
import Phone from './Phone.astro';
interface Props { heading?: string; body?: string; placement?: string }
const {
  heading = 'Next time, just point your camera.',
  body = 'Opus recognizes paintings, sculpture and objects from a photo, then shows you who made them, where to see more, and what other visitors thought. We’re letting testers in now.',
  placement = 'guide-end',
} = Astro.props;
---
<section class="end-cta ground not-prose" aria-label="Request early access">
  <div class="copy">
    <p class="eyebrow">Early access</p>
    <h2 class="display">{heading}</h2>
    <p class="b">{body}</p>
    <AccessForm placement={placement} tone="dark" />
  </div>
  <div class="phones" aria-hidden="true">
    <Phone screen="camera" alt="" width={170} class="p1" />
    <Phone screen="work" alt="" width={170} class="p2" />
  </div>
</section>
<style>
  .end-cta { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: center; padding: 40px; border-radius: 22px; margin: 56px 0 0; overflow: hidden; }
  .eyebrow { color: #d9b56a; margin: 0 0 12px; }
  h2 { font-size: clamp(30px, 4vw, 40px); margin: 0 0 12px; color: #fff; }
  .b { color: #ead9c7; margin: 0 0 22px; }
  .phones { position: relative; height: 300px; }
  :global(.end-cta .p1) { position: absolute; left: 6%; top: 10px; transform: rotate(-6deg); }
  :global(.end-cta .p2) { position: absolute; right: 2%; top: 40px; transform: rotate(5deg); }
  @media (max-width: 760px) { .end-cta { grid-template-columns: 1fr; padding: 28px 22px; } .phones { display: none; } }
</style>
