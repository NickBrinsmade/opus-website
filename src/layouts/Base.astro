---
import '@fontsource/bodoni-moda/500.css';
import '@fontsource/bodoni-moda/500-italic.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource/baloo-2/latin-800.css';
import '../styles/global.css';
// Preloaded so the headline, hero copy and wordmark don't reflow when fonts swap in (CLS).
import bodoni500 from '@fontsource/bodoni-moda/files/bodoni-moda-latin-500-normal.woff2?url';
import bodoni500i from '@fontsource/bodoni-moda/files/bodoni-moda-latin-500-italic.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import baloo800 from '@fontsource/baloo-2/files/baloo-2-latin-800-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, url, POSTHOG_KEY, POSTHOG_HOST, CF_BEACON_TOKEN } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, image, type = 'website', jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? url('/img/og.png'), Astro.site);
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title} | ${SITE.name}`;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: new URL(url('/'), Astro.site).href,
  logo: new URL(url('/img/icon-512.png'), Astro.site).href,
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  {[bodoni500, bodoni500i, interLatin, baloo800].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#521B24" />
  <link rel="icon" type="image/png" href={url('/favicon.png') + '?v=2'} />
  <link rel="apple-touch-icon" href={url('/apple-touch-icon.png') + '?v=2'} />
  <link rel="sitemap" href={url('/sitemap-index.xml')} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
  <script is:inline define:vars={{ POSTHOG_KEY, POSTHOG_HOST }}>
    window.__opus = { events: [], key: POSTHOG_KEY, host: POSTHOG_HOST };
  </script>
  {CF_BEACON_TOKEN && !import.meta.env.DEV && (
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}></script>
  )}
</head>
<body>
  <a class="sr-only" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <script>
    import '../scripts/track';
    import '../scripts/access-form';
  </script>
</body>
</html>
